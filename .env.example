# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# AI chatbot (server-side only — never exposed to the browser).
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the chat model. Defaults to gpt-4o-mini (fast + cheap,
# which suits a short-answer FAQ assistant). Use gpt-4o for higher quality.
OPENAI_MODEL=

# Google Tag Manager container ID (format: GTM-XXXXXXX).
# GA4, Google Ads conversions, Meta Pixel and Clarity are all configured as
# tags INSIDE this container — do not add those scripts to the codebase.
# Leave blank locally; the tag then does not load at all.
NEXT_PUBLIC_GTM_ID=

# Supabase — appointment storage (see the maintenance guide).
# The service role key is server-side only and must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=
